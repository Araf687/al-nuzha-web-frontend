            "description": "Update part details (name, sku, unitPrice, minStockLevel). Only provide fields to change. To update stock use /set-remaining or create a challan."
          }
        },
        {
          "name": "Approve Custom Part",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/parts/{{partId}}/approve", "host": ["{{baseUrl}}"], "path": ["parts", "{{partId}}", "approve"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"COPPER-ELBOW-025\",\n  \"unitPrice\": 12.50,\n  \"minStockLevel\": 10\n}"
            },
            "description": "Admin — approve a custom part added by a technician. Sets `needsReview: false` and allows updating the official SKU and pricing."
          }
        },
        {
          "name": "Set Remaining Qty (Month-End)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/parts/{{partId}}/set-remaining", "host": ["{{baseUrl}}"], "path": ["parts", "{{partId}}", "set-remaining"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qty\": 2\n}"
            },
            "description": "Admin — end-of-month physical stock reconciliation. Sets `stockQty` to the exact remaining quantity counted in the storeroom.\n\nExample: 20 taps were purchased (added via challan), 18 were used by workers during the month, 2 remain. Admin enters `qty: 2` → `stockQty` is set to `2`.\n\nThis replaces any calculated value with the ground-truth physical count."
          }
        }
